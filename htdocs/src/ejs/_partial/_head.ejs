<%
 // ページのmeta情報
 var myMeta = meta[lang][pageID];
 // 共通のmeta情報
 var commonMeta = meta[lang].common;

 // タイトルの設定
 var title;
 if (pageID == "top") {
  title = commonMeta.title;
 } else {
  title = myMeta.title + " | " + commonMeta.title;
 }
 %>
<head>
  <meta charset="utf-8">
  <!-- Google Tag Manager -->
  <script>
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f = d.getElementsByTagName(s)[0],
        j = d.createElement(s),
        dl = l != 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', 'GTM-WKM95WS');
  </script>
  <!-- End Google Tag Manager -->
  <!-- title -->
  <title><%= title %></title>
  <meta name="viewport" content="width=device-width">
  <meta name="description" content="<%- commonMeta.description %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%- commonMeta.description %>">
  <meta name="twitter:url" content="<%= commonMeta.og_url %>">
  <meta name="twitter:image" content="<%= commonMeta.og_img %>">
  <meta name="twitter:site" content="<%= commonMeta.twitter_id %>">
  <meta property="og:site_name" content="<%= title %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%- commonMeta.description %>">
  <meta property="og:url" content="<%= commonMeta.og_url %>">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= commonMeta.og_img %>">
  <!-- font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400..700&family=Noto+Sans+JP:wght@100..900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Zen+Kaku+Gothic+Antique:wght@300;400;500;700;900&display=swap"
    rel="stylesheet"
  >
  <!-- favicon -->
  <link rel="shortcut icon" href="<%= relative_path %>assets/img/favicon.ico">
  <link
    rel="apple-touch-icon"
    href="<%= commonMeta.url %>assets/img/webclip.png"
  >
  <!-- css -->
  <link rel="stylesheet" href="<%= relative_path %>assets/css/share.css">
</head>
