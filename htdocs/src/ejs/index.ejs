<%
// ページのIDを記述
var pageID = "top";
// 言語設定
var lang = "ja";
// ファイルの相対パス
var relative_path = "./";
// このページのmeta情報
var myMeta = meta[lang][pageID];
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
  <%-include(`${relative_path}_partial/_head`,{lang:lang,pageID:pageID,relative_path:relative_path})%>
  <body>
    <%-include(`${relative_path}_partial/_body-after`,{lang:lang,pageID:pageID,relative_path:relative_path})%>
    <%# ここから下にhtml書いてね このコメントは反映されません%>
    <main class="common__main">
      <div class="common__bg sp-none"></div>
      <div class="common__loading">
        <span class="common__loading-item"></span>
      </div>
      <article class="common__article">
        <div class="common__wrap">
          <div class="common__label">
            <p class="common__label-name">NEWSLETTER</p>
            <p class="common__label-date">2026.3.16</p>
          </div>
          <span class="common__line rotate"></span>
          <h1 class="common__h1">
            <img
              src="<%= relative_path %>assets/img/common/img_mv.png"
              alt="9周年 PROJECT LIVEHOUSE CIRCLE 社内報 NEWSLETTER"
            >
          </h1>
          <span class="common__line"></span>
          <section class="top-player">
            <h2 class="top-player__ttl">
              <img
                src="<%= relative_path %>assets/img/ttl_history.png"
                alt="これまでの活動履歴をお届け！"
              >
            </h2>
            <div class="common__inner">
              <div class="top-player__pass">
                <p class="top-player__pass-ttl">PLAYER PASS</p>
                <dl class="top-player__identity">
                  <dt>ID</dt>
                  <dd class="id">1001</dd>
                  <dt>NAME</dt>
                  <dd class="name">新人スタッフ</dd>
                </dl>
                <dl class="top-player__identity">
                  <dt>SINCE</dt>
                  <dd class="join"><span>2016.01.08</span> -</dd>
                </dl>
              </div>
            </div>
            <div class="top-player__data">
              <div class="top-player__data-block">
                <h2>
                  <img
                    src="<%= relative_path %>assets/img/ttl_data_1.png"
                    alt="DATA 01 プレイ記録"
                  >
                </h2>
                <div class="top-player__data-inner">
                  <dl class="top-player__data-item">
                    <dt>ログイン日数</dt>
                    <dd>
                      <p><span class="txt-number">3052</span> 日</p>
                    </dd>
                  </dl>
                  <dl class="top-player__data-item">
                    <dt>読破済みストーリー</dt>
                    <dd>
                      <ul>
                        <li>
                          <p class="list-ttl">メイン<br>ストーリー</p>
                          <p><span class="txt-number">40</span> 話</p>
                        </li>
                        <li>
                          <p class="list-ttl">バンド<br>ストーリー</p>
                          <p><span class="txt-number">5</span> 話</p>
                        </li>
                        <li>
                          <p class="list-ttl">イベント<br>ストーリー</p>
                          <p><span class="txt-number">442</span> 話</p>
                        </li>
                      </ul>
                    </dd>
                  </dl>
                  <dl class="top-player__data-item">
                    <dt>ラウンジ会話視聴</dt>
                    <dd>
                      <p><span class="txt-number">72</span> 回</p>
                    </dd>
                  </dl>
                </div>
              </div>
              <div class="top-player__data-block">
                <h2>
                  <img
                    src="<%= relative_path %>assets/img/ttl_data_2.png"
                    alt="DATA 02 メンバー"
                  >
                </h2>
                <div class="top-player__data-inner">
                  <dl class="top-player__data-item">
                    <dt>集めたカード</dt>
                    <dd>
                      <p><span class="txt-number">512 / 780</span> 枚</p>
                    </dd>
                  </dl>
                  <dl class="top-player__data-item">
                    <dt>一番集めているメンバー</dt>
                    <dd>
                      <p class="txt-name">戸山 香澄</p>
                    </dd>
                  </dl>
                  <dl class="top-player__data-item">
                    <dt>最初に引いたメンバー</dt>
                    <dd>
                      <p class="txt-name">戸山 香澄</p>
                      <div class="card">
                        <span class="card-star">★★★</span>
                        <p class="card-name">約束のキャンディ</p>
                      </div>
                    </dd>
                  </dl>
                </div>
                <div class="top-player__data-chara">
                  <span>
                    <img
                      src="<%= relative_path %>assets/img/member/1/member.png"
                      alt="戸山 香澄"
                    >
                  </span>
                  <p>
                    <img
                      src="<%= relative_path %>assets/img/member_copy.png"
                      alt="あなたが一番集めているのはこのメンバー！"
                    >
                  </p>
                </div>
              </div>
              <div class="top-player__data-block">
                <h2>
                  <img
                    src="<%= relative_path %>assets/img/ttl_data_3.png"
                    alt="DATA 03 楽曲クリア率"
                  >
                </h2>
                <div class="common__inner">
                  <div class="top-player__graph">
                    <div class="top-player__graph-wrap">
                      <div
                        class="top-player__graph-item is-easy"
                        style="height: 98.4%"
                      >
                        <p class="top-player__graph-score">
                          <span>740</span>
                          <span>752</span>
                        </p>
                        <p class="top-player__graph-percent">98.4%</p>
                      </div>
                      <div
                        class="top-player__graph-item is-normal"
                        style="height: 86.6%"
                      >
                        <p class="top-player__graph-score">
                          <span>651</span>
                          <span>752</span>
                        </p>
                        <p class="top-player__graph-percent">86.6%</p>
                      </div>
                      <div
                        class="top-player__graph-item is-hard"
                        style="height: 66.6%"
                      >
                        <p class="top-player__graph-score">
                          <span>501</span>
                          <span>752</span>
                        </p>
                        <p class="top-player__graph-percent">66.6%</p>
                      </div>
                      <div
                        class="top-player__graph-item is-expert"
                        style="height: 12.9%"
                      >
                        <p class="top-player__graph-score">
                          <span>97</span>
                          <span>752</span>
                        </p>
                        <p class="top-player__graph-percent">12.9%</p>
                      </div>
                      <div
                        class="top-player__graph-item is-special"
                        style="height: 3.5%"
                      >
                        <p class="top-player__graph-score">
                          <span>15</span>
                          <span>431</span>
                        </p>
                        <p class="top-player__graph-percent">3.5%</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="top-player__data-block">
                <h2>
                  <img
                    src="<%= relative_path %>assets/img/ttl_data_4.png"
                    alt="DATA 04 その他"
                  >
                </h2>
                <div class="top-player__data-inner">
                  <dl class="top-player__data-item">
                    <dt>最初にフルコンボした楽曲</dt>
                    <dd>
                      <div class="song">
                        <div class="song-level" data-level="EASY">
                          <p>ときめきエクスペリエンス！</p>
                        </div>
                        <div class="song-level" data-level="NORMAL">
                          <p>キラキラだとか夢だとか ～Sing Girls～</p>
                        </div>
                        <div class="song-level" data-level="HARD">
                          <p>YAPPY！SCHOOL CARNIVAL☆彡</p>
                        </div>
                        <div class="song-level" data-level="EXPERT">
                          <p>What's the POPIPA!?</p>
                        </div>
                        <div class="song-level" data-level="SPECIAL">
                          <p>誓いのWingbeat</p>
                        </div>
                      </div>
                    </dd>
                  </dl>
                  <dl class="top-player__data-item">
                    <dt>初めてTOP10000入りしたイベント</dt>
                    <dd>
                      <p>パスパレ探検隊～無人島を征くアイドル～</p>
                      <p><span>（4192位）</span></p>
                    </dd>
                  </dl>
                  <dl class="top-player__data-item">
                    <dt>あなたと同期の楽曲</dt>
                    <dd><p>オトモダチフィルム</p></dd>
                  </dl>
                </div>
              </div>
            </div>
          </section>
          <%- include( `${relative_path}_partial/_footer`,{lang:lang,pageID:pageID,relative_path:relative_path}) %>
        </div>
      </article>
    </main>
    <%# ここから上にhtml書いてね このコメントは反映されません%>
    <%- include( `${relative_path}_partial/_foot`,{lang:lang,pageID:pageID,relative_path:relative_path}) %>
  </body>
</html>
